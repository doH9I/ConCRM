# CRM System Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=db-server
DB_PORT=5432
DB_NAME=crm_prod
DB_USER=crm_user
DB_PASSWORD=secure_crm_password_2024
DB_SSL=false

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=db-server
REDIS_PORT=6379
REDIS_PASSWORD=secure_redis_password_2024
REDIS_DB=0

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
JWT_SECRET=your_super_secret_jwt_key_for_crm_2024_change_this_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@yourcompany.com
SMTP_SECURE=true

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=3001
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000
UPLOAD_MAX_SIZE=100MB
SESSION_SECRET=your_session_secret_2024

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
PROMETHEUS_ENABLED=true
METRICS_PORT=9091
GRAFANA_ADMIN_PASSWORD=admin123
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_EMAIL=devops@yourcompany.com
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=us-east-1
S3_BUCKET=your-crm-backups-bucket

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100
PASSWORD_MIN_LENGTH=8
SESSION_TIMEOUT=3600

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/opt/crm/logs/application.log
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ZONE_ID=YOUR_CLOUDFLARE_ZONE_ID
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL

# =============================================================================
# DEVELOPMENT OVERRIDES (set to false in production)
# =============================================================================
DEBUG=false
ENABLE_SWAGGER=false
ENABLE_GRAPHIQL=false
SKIP_AUTH=false