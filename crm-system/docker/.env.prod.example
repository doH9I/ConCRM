# Production Environment Configuration
# Copy this file to .env.prod and update with your production values

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=crm_prod_user
DB_PASSWORD=your-super-secure-production-password
DB_NAME=crm_prod
DB_SSL=true

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-super-secure-redis-password
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secure-production-jwt-secret-key-here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt Configuration
BCRYPT_ROUNDS=12

# Server Configuration
PORT=3001
NODE_ENV=production
API_PREFIX=api
CORS_ORIGIN=https://your-domain.com

# Prometheus Metrics
PROMETHEUS_ENABLED=true
METRICS_PORT=9091

# Notification Services
TELEGRAM_BOT_TOKEN=your-production-bot-token
TELEGRAM_CHAT_ID=your-production-chat-id
SLACK_WEBHOOK_URL=your-production-webhook-url
DISCORD_WEBHOOK_URL=your-production-webhook-url

# Email Configuration
SMTP_HOST=smtp.your-domain.com
SMTP_PORT=587
SMTP_USER=noreply@your-domain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@your-domain.com

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=your-secure-grafana-admin-password
GRAFANA_DOMAIN=your-domain.com:3000

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100