# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ticket_aggregator
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# API Keys for Ticket Providers
AVIASALES_API_KEY=your_aviasales_api_key
OMIO_API_KEY=your_omio_api_key
KIWI_API_KEY=your_kiwi_api_key
BUSFOR_API_KEY=your_busfor_api_key

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# External APIs
AVIASALES_BASE_URL=https://api.aviasales.com
OMIO_BASE_URL=https://api.omio.com
KIWI_BASE_URL=https://api.kiwi.com
BUSFOR_BASE_URL=https://api.busfor.com